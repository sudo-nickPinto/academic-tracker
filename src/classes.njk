---
layout: base.njk
pagination:
  data: classes
  size: 1
  alias: class
permalink: "/classes/{{ class.id }}/"
eleventyComputed:
  title: "{{ class.code }} — {{ class.name }}"
---
<h1>{{ class.code }} &mdash; {{ class.name }}</h1>
<p class="class-meta">
  {% if class.instructor %}{{ class.instructor }} &middot; {% endif %}
  {% if class.meeting_times %}{{ class.meeting_times }} &middot; {% endif %}
  {{ class.term }}
</p>
{% if class.materials_link %}<p><a href="{{ class.materials_link }}">Course site &rarr;</a></p>{% endif %}

<details class="inline-manage">
  <summary>Edit Class Info</summary>
  <form class="manage-form edit-form" data-edit-form data-id="{{ class.id }}" data-file="classes.yaml">
    <label>Code<input type="text" name="code" value="{{ class.code }}" required></label>
    <label>Name<input type="text" name="name" value="{{ class.name }}" required></label>
    <label>Term<input type="text" name="term" value="{{ class.term }}"></label>
    <label>Instructor<input type="text" name="instructor" value="{{ class.instructor }}"></label>
    <label>Meeting times<input type="text" name="meeting_times" value="{{ class.meeting_times }}"></label>
    <label>Color<input type="color" name="color" value="{{ class.color or '#2b6cb0' }}"></label>
    <label>Course site link (optional)<input type="url" name="materials_link" value="{{ class.materials_link }}"></label>
    <label>Status
      <select name="status">
        <option value="active" {{ "selected" if class.status == "active" }}>active</option>
        <option value="archived" {{ "selected" if class.status == "archived" }}>archived</option>
      </select>
    </label>
    <button type="submit">Save</button>
    <p class="form-status"></p>
  </form>
</details>

<section>
  <h2>Materials</h2>
  {% set classMaterials = materials | byClass(class.id) %}
  <div data-list="materials">
    <ul data-reorder-list data-file="materials.yaml">
    {% for m in classMaterials %}
      <li draggable="true" data-id="{{ m.id }}" data-row>
        <span class="drag-handle" aria-hidden="true">⠿</span>
        {% if m.link %}<a href="{{ m.link }}">{{ m.title }}</a>{% else %}{{ m.title }}{% endif %}
        <span class="tag">{{ m.type }}</span>
        <span class="row-actions" draggable="false">
          <details class="inline-manage row-edit">
            <summary>Edit</summary>
            <form class="manage-form edit-form" data-edit-form data-id="{{ m.id }}" data-file="materials.yaml">
              <label>Title<input type="text" name="title" value="{{ m.title }}" required></label>
              <label>Type
                <select name="type">
                  <option value="syllabus" {{ "selected" if m.type == "syllabus" }}>syllabus</option>
                  <option value="slides" {{ "selected" if m.type == "slides" }}>slides</option>
                  <option value="reading" {{ "selected" if m.type == "reading" }}>reading</option>
                  <option value="recording" {{ "selected" if m.type == "recording" }}>recording</option>
                  <option value="link" {{ "selected" if m.type == "link" }}>link</option>
                  <option value="other" {{ "selected" if m.type == "other" }}>other</option>
                </select>
              </label>
              <label>Link<input type="url" name="link" value="{{ m.link }}"></label>
              <button type="submit">Save</button>
              <p class="form-status"></p>
            </form>
          </details>
          <button type="button" class="delete-btn" data-delete-btn
            data-id="{{ m.id }}" data-file="materials.yaml" data-label="material">Delete</button>
        </span>
      </li>
    {% endfor %}
    </ul>
    {% if classMaterials.length == 0 %}
      <p class="empty">No materials added yet.</p>
    {% elif classMaterials.length > 1 %}
      <p class="hint" data-reorder-status="materials.yaml">Drag to reorder.</p>
    {% endif %}
  </div>

  <details class="inline-manage">
    <summary>Add Material</summary>
    <form id="form-material" class="manage-form">
      <label>Title<input type="text" name="title" required></label>
      <label>Type
        <select name="type" required>
          <option value="syllabus">syllabus</option>
          <option value="slides">slides</option>
          <option value="reading">reading</option>
          <option value="recording">recording</option>
          <option value="link">link</option>
          <option value="other">other</option>
        </select>
      </label>
      <label>Link (optional, ignored if you attach a file below)<input type="url" name="link"></label>
      <div class="drop-zone" data-drop-zone>
        <label>Attach a file (optional, max 5 MB)<input type="file" name="file"></label>
        <p class="drop-zone-hint">Drag a file here, or click to browse.</p>
      </div>
      <button type="submit">Add Material</button>
      <p class="form-status"></p>
    </form>
  </details>
</section>

<section>
  <h2>Deadlines</h2>
  {% set classDeadlines = deadlines | byClass(class.id) | sortByDate("due_date") %}
  <div class="deadline-list" data-list="deadlines">
  {% for d in classDeadlines %}
    {% include "deadline-row.njk" %}
  {% endfor %}
  {% if classDeadlines.length == 0 %}<p class="empty">No deadlines added yet.</p>{% endif %}
  </div>

  <details class="inline-manage">
    <summary>Add Deadline</summary>
    <form id="form-deadline" class="manage-form">
      <label>Title<input type="text" name="title" placeholder="Homework 3" required></label>
      <label>Type
        <select name="type" required>
          <option value="assignment">assignment</option>
          <option value="exam">exam</option>
          <option value="reading">reading</option>
          <option value="project">project</option>
          <option value="other">other</option>
        </select>
      </label>
      <label>Due date (YYYY-MM-DDTHH:MM, or "TBD")<input type="text" name="due_date" placeholder="2026-09-29T14:35" required></label>
      <label>Link (optional)<input type="url" name="link"></label>
      <label>Notes (optional)<textarea name="notes" placeholder="Flag anything inferred or guessed here."></textarea></label>
      <button type="submit">Add Deadline</button>
      <p class="form-status"></p>
    </form>
  </details>
</section>

<section>
  <h2>Grades</h2>
  {% set classGrades = grades | byClass(class.id) %}
  {% set breakdown = classGrades | gradeBreakdown(class) %}
  {% set overall = breakdown | weightedOverall %}
  {% if overall != null %}<p class="grade-average">{{ overall }}%</p>{% endif %}
  {% for cat in breakdown %}
    {% if cat.entries.length > 0 %}
      <div class="grade-category">
        {% if cat.name %}
          <p class="grade-category-name">{{ cat.name }}{% if cat.weight %} <span class="grade-weight">{{ cat.weight }}%</span>{% endif %}{% if cat.average != null %} &middot; {{ cat.average }}%{% endif %}</p>
        {% endif %}
        <ul class="grade-list">
        {% for g in cat.entries %}
          <li data-row>
            <span class="grade-item">{{ g.item }}</span>
            {% if g.score != null and g.max != null %}<span class="grade-score">{{ g.score }}/{{ g.max }}</span>{% endif %}
            <details class="inline-manage row-edit">
              <summary>Edit</summary>
              <form class="manage-form edit-form" data-edit-form data-id="{{ g.id }}" data-file="grades.yaml">
                <label>Item<input type="text" name="item" value="{{ g.item }}" required></label>
                <label>Category<input type="text" name="category" value="{{ g.category }}"></label>
                <label>Score<input type="number" step="any" name="score" value="{{ g.score }}" required></label>
                <label>Max<input type="number" step="any" name="max" value="{{ g.max }}" required></label>
                <label>Date (optional)<input type="date" name="date" value="{{ g.date }}"></label>
                <button type="submit">Save</button>
                <p class="form-status"></p>
              </form>
            </details>
            <button type="button" class="delete-btn" data-delete-btn
              data-id="{{ g.id }}" data-file="grades.yaml" data-label="grade">Delete</button>
          </li>
        {% endfor %}
        </ul>
      </div>
    {% endif %}
  {% endfor %}
  {% if classGrades.length == 0 %}<p class="empty">No grades recorded yet.</p>{% endif %}

  <details class="inline-manage">
    <summary>Add Grade</summary>
    <form id="form-grade" class="manage-form">
      <label>Item<input type="text" name="item" placeholder="Test 1" required></label>
      <label>Category<input type="text" name="category" placeholder="Matches a grade_categories name, if the class has one"></label>
      <label>Score<input type="number" step="any" name="score" required></label>
      <label>Max<input type="number" step="any" name="max" required></label>
      <label>Date (optional)<input type="date" name="date"></label>
      <button type="submit">Add Grade</button>
      <p class="form-status"></p>
    </form>
  </details>
</section>

<section>
  <h2>Notes</h2>
  {% set classNotes = notes | byClass(class.id) | sortByDate("date") | reverse %}
  <div data-list="notes">
  {% for n in classNotes %}
    <div class="note" data-row>
      <p class="note-date">{{ n.date | formatDate }}</p>
      <h3>{{ n.title }}</h3>
      <div class="note-body">{{ n.body | markdown | safe }}</div>
      {% if n.attachment %}<p><a href="{{ n.attachment }}">Attachment &rarr;</a></p>{% endif %}
      <div class="row-actions">
        <details class="inline-manage row-edit">
          <summary>Edit</summary>
          <form class="manage-form edit-form" data-edit-form data-id="{{ n.id }}" data-file="notes.yaml">
            <label>Title<input type="text" name="title" value="{{ n.title }}" required></label>
            <label>Date<input type="date" name="date" value="{{ n.date }}"></label>
            <label>Body (Markdown supported)<textarea name="body" required>{{ n.body }}</textarea></label>
            <button type="submit">Save</button>
            <p class="form-status"></p>
          </form>
        </details>
        <button type="button" class="delete-btn" data-delete-btn
          data-id="{{ n.id }}" data-file="notes.yaml" data-label="note">Delete</button>
      </div>
    </div>
  {% endfor %}
  {% if classNotes.length == 0 %}<p class="empty">No notes yet.</p>{% endif %}
  </div>

  <details class="inline-manage">
    <summary>Add Note</summary>
    <form id="form-note" class="manage-form">
      <label>Title<input type="text" name="title" required></label>
      <label>Date (optional, defaults to today)<input type="date" name="date"></label>
      <label>Body (Markdown supported)<textarea name="body" required></textarea></label>
      <div class="drop-zone" data-drop-zone>
        <label>Attach a file (optional, max 5 MB)<input type="file" name="file"></label>
        <p class="drop-zone-hint">Drag a file here, or click to browse.</p>
      </div>
      <button type="submit">Add Note</button>
      <p class="form-status"></p>
    </form>
  </details>
</section>

<section>
  <h2>Announcements</h2>
  {% set classAnn = announcements | byClass(class.id) | sortByDate("date") | reverse %}
  <div data-list="announcements">
  {% for a in classAnn %}
    <div class="announcement" data-row>
      <p class="announcement-date">{{ a.date | formatDate }}</p>
      <h3>{{ a.title }}</h3>
      <p>{{ a.body }}</p>
      <div class="row-actions">
        <details class="inline-manage row-edit">
          <summary>Edit</summary>
          <form class="manage-form edit-form" data-edit-form data-id="{{ a.id }}" data-file="announcements.yaml">
            <label>Title<input type="text" name="title" value="{{ a.title }}" required></label>
            <label>Date<input type="date" name="date" value="{{ a.date }}"></label>
            <label>Body<textarea name="body" required>{{ a.body }}</textarea></label>
            <button type="submit">Save</button>
            <p class="form-status"></p>
          </form>
        </details>
        <button type="button" class="delete-btn" data-delete-btn
          data-id="{{ a.id }}" data-file="announcements.yaml" data-label="announcement">Delete</button>
      </div>
    </div>
  {% endfor %}
  {% if classAnn.length == 0 %}<p class="empty">No announcements yet.</p>{% endif %}
  </div>

  <details class="inline-manage">
    <summary>Add Announcement</summary>
    <form id="form-announcement" class="manage-form">
      <label>Title<input type="text" name="title" required></label>
      <label>Date (optional, defaults to today)<input type="date" name="date"></label>
      <label>Body<textarea name="body" required></textarea></label>
      <button type="submit">Add Announcement</button>
      <p class="form-status"></p>
    </form>
  </details>
</section>

<p class="hint">Need a GitHub token first? Set one up on <a href="{{ '/settings/' | url }}">Settings</a>.</p>

<script>window.CLASS_ID = {{ class.id | dump | safe }};</script>
<script type="module" src="{{ '/js/class-manage.js' | url }}"></script>
<script type="module" src="{{ '/js/reorder.js' | url }}"></script>
