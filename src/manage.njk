---
layout: base.njk
title: "Manage"
permalink: "/manage/"
---
<h1>Manage</h1>
<p class="subtitle">Add content straight from the browser — each form commits directly to this repo's data files and triggers a rebuild. Needs a GitHub token first: set one up on <a href="{{ '/settings/' | url }}">Settings</a>.</p>
<p class="hint">Prefer email or the GitHub mobile app instead? The <a href="https://github.com/{{ site.repo }}/issues/new/choose">Issue Forms</a> still work exactly as before — this page is an additional, faster path, not a replacement.</p>

<section>
  <h2>Add Deadline</h2>
  <form id="form-deadline" class="manage-form">
    <label>Class
      <select name="class_id" data-class-select required><option value="">Select a class…</option></select>
    </label>
    <label>Title<input type="text" name="title" placeholder="Homework 3" required></label>
    <label>Type
      <select name="type" required>
        <option value="assignment">assignment</option>
        <option value="exam">exam</option>
        <option value="reading">reading</option>
        <option value="project">project</option>
        <option value="other">other</option>
      </select>
    </label>
    <label>Due date (YYYY-MM-DDTHH:MM, or "TBD")<input type="text" name="due_date" placeholder="2026-09-29T14:35" required></label>
    <label>Link (optional)<input type="url" name="link"></label>
    <label>Notes (optional)<textarea name="notes" placeholder="Flag anything inferred or guessed here."></textarea></label>
    <button type="submit">Add Deadline</button>
    <p class="form-status"></p>
  </form>
</section>

<section>
  <h2>Add Note</h2>
  <form id="form-note" class="manage-form">
    <label>Class
      <select name="class_id" data-class-select required><option value="">Select a class…</option></select>
    </label>
    <label>Title<input type="text" name="title" required></label>
    <label>Date (optional, defaults to today)<input type="date" name="date"></label>
    <label>Body (Markdown supported)<textarea name="body" required></textarea></label>
    <button type="submit">Add Note</button>
    <p class="form-status"></p>
  </form>
</section>

<section>
  <h2>Add Grade</h2>
  <form id="form-grade" class="manage-form">
    <label>Class
      <select name="class_id" data-class-select required><option value="">Select a class…</option></select>
    </label>
    <label>Item<input type="text" name="item" placeholder="Test 1" required></label>
    <label>Category<input type="text" name="category" placeholder="Matches a grade_categories name, if the class has one"></label>
    <label>Score<input type="number" step="any" name="score" required></label>
    <label>Max<input type="number" step="any" name="max" required></label>
    <label>Date (optional)<input type="date" name="date"></label>
    <button type="submit">Add Grade</button>
    <p class="form-status"></p>
  </form>
</section>

<section>
  <h2>Add Announcement</h2>
  <form id="form-announcement" class="manage-form">
    <label>Class
      <select name="class_id" data-class-select required><option value="">Select a class…</option></select>
    </label>
    <label>Title<input type="text" name="title" required></label>
    <label>Date (optional, defaults to today)<input type="date" name="date"></label>
    <label>Body<textarea name="body" required></textarea></label>
    <button type="submit">Add Announcement</button>
    <p class="form-status"></p>
  </form>
</section>

<section>
  <h2>Add Material</h2>
  <form id="form-material" class="manage-form">
    <label>Class
      <select name="class_id" data-class-select required><option value="">Select a class…</option></select>
    </label>
    <label>Title<input type="text" name="title" required></label>
    <label>Type
      <select name="type" required>
        <option value="syllabus">syllabus</option>
        <option value="slides">slides</option>
        <option value="reading">reading</option>
        <option value="recording">recording</option>
        <option value="link">link</option>
        <option value="other">other</option>
      </select>
    </label>
    <label>Link (optional)<input type="url" name="link"></label>
    <button type="submit">Add Material</button>
    <p class="form-status"></p>
  </form>
</section>

<section>
  <h2>Add Reminder</h2>
  <form id="form-reminder" class="manage-form">
    <label>Title<input type="text" name="title" required></label>
    <label>Date (optional — omit for a standing reminder)<input type="date" name="date"></label>
    <label>Note (optional)<input type="text" name="note"></label>
    <button type="submit">Add Reminder</button>
    <p class="form-status"></p>
  </form>
</section>

<section>
  <h2>Add Class</h2>
  <form id="form-class" class="manage-form">
    <label>Code<input type="text" name="code" placeholder="CS 420" required></label>
    <label>ID (slug — optional, derived from the code if left blank)<input type="text" name="id" placeholder="cs420"></label>
    <label>Name<input type="text" name="name" placeholder="Full course title" required></label>
    <label>Term<input type="text" name="term" value="{{ site.current_term }}"></label>
    <label>Instructor<input type="text" name="instructor"></label>
    <label>Meeting times<input type="text" name="meeting_times" placeholder="Tue/Thu 2:35–3:50pm, Room 213"></label>
    <label>Color<input type="color" name="color" value="#2b6cb0"></label>
    <label>Course site link (optional)<input type="url" name="materials_link"></label>
    <button type="submit">Add Class</button>
    <p class="form-status"></p>
  </form>
  <p class="hint">A newly added class won't appear in this page's own dropdowns until the site rebuilds — reload this page after a minute.</p>
</section>

<script>window.CLASSES = {{ classes | dump | safe }};</script>
<script type="module" src="{{ '/js/manage.js' | url }}"></script>
