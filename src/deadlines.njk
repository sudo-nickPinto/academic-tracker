---
layout: base.njk
title: "Up Next"
permalink: "/deadlines/"
---
<h1>Up Next</h1>
<p class="subtitle">Everything on your plate — assignments, exams, projects, and reminders — in one chronological list.</p>
<p><a href="{{ '/deadlines.ics' | url }}">Add to Calendar (.ics) &rarr;</a></p>

{% set combined = deadlines | combinedAgenda(reminders) %}
{% set active = combined | notDone | sortByDate("due_date") %}

<section>
  <h2>Overdue</h2>
  {% set overdueList = active | overdue %}
  <div class="deadline-list">
  {% for item in overdueList %}
    {% if item.kind == "deadline" %}{% set d = item.entry %}{% include "deadline-row.njk" %}
    {% else %}{% set r = item.entry %}{% include "reminder-row.njk" %}{% endif %}
  {% endfor %}
  </div>
  {% if overdueList.length == 0 %}<p class="empty">Nothing overdue.</p>{% endif %}
</section>

<section>
  <h2>This Week</h2>
  {% set weekList = active | dueThisWeek %}
  <div class="deadline-list">
  {% for item in weekList %}
    {% if item.kind == "deadline" %}{% set d = item.entry %}{% include "deadline-row.njk" %}
    {% else %}{% set r = item.entry %}{% include "reminder-row.njk" %}{% endif %}
  {% endfor %}
  </div>
  {% if weekList.length == 0 %}<p class="empty">Nothing due this week.</p>{% endif %}
</section>

<section>
  <h2>Later</h2>
  {% set laterList = active | dueLater %}
  <div class="deadline-list">
  {% for item in laterList %}
    {% if item.kind == "deadline" %}{% set d = item.entry %}{% include "deadline-row.njk" %}
    {% else %}{% set r = item.entry %}{% include "reminder-row.njk" %}{% endif %}
  {% endfor %}
  </div>
  {% if laterList.length == 0 %}<p class="empty">Nothing further out.</p>{% endif %}
</section>

<section>
  <h2>Done</h2>
  {% set doneList = combined | doneOnly | sortByDate("due_date") %}
  <div class="deadline-list">
  {% for item in doneList %}
    {% if item.kind == "deadline" %}{% set d = item.entry %}{% include "deadline-row.njk" %}
    {% else %}{% set r = item.entry %}{% include "reminder-row.njk" %}{% endif %}
  {% endfor %}
  </div>
  {% if doneList.length == 0 %}<p class="empty">Nothing completed yet.</p>{% endif %}
</section>
