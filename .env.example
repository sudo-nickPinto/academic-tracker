# Copy this file to .env and fill in the values you need. .env is gitignored —
# never commit real credentials to this public repo.

# --- Phase 3: Outlook / Microsoft Graph sync (scripts/sync-outlook.js) ---
# Application (client) ID of an Azure AD app registration with "Mobile and
# desktop applications" platform + the "Allow public client flows" setting on,
# and the Calendars.Read delegated permission granted. See CLAUDE.md's Roadmap
# for setup notes.
AZURE_CLIENT_ID=
# Directory (tenant) ID, or leave unset/"common" for personal + work/school
# accounts. A school-managed tenant may block app registration entirely —
# check with school IT if sign-in fails.
AZURE_TENANT_ID=common
# How many days ahead to pull calendar events for. Defaults to 30.
OUTLOOK_SYNC_DAYS_AHEAD=30
